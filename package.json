{
  "name": "ts.data.json",
  "version": "4.3.1",
  "description": "A JSON decoding library for Typescript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/src/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mini": {
      "import": {
        "types": "./dist/types/src/mini.d.ts",
        "default": "./dist/mini.js"
      },
      "require": {
        "types": "./dist/types-cjs/src/mini.d.cts",
        "default": "./dist/mini.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "postbuild": "node scripts/fix-declaration-specifiers.mjs",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:dist": "vitest run -c vitest.dist.config.ts",
    "lint": "eslint src/",
    "format": "prettier ./src --write && prettier ./assets/documents --write",
    "format:check": "prettier ./src --check && prettier ./assets/documents --check",
    "prebeta": "npm run test && npm run lint",
    "beta": "npm whoami && npm run build && npm publish --tag beta",
    "docs": "typedoc",
    "postdocs": "mkdir -p docs/media && cp assets/media/github-mark.png docs/media/ && cp assets/media/github-mark-white.png docs/media/"
  },
  "keywords": [
    "json",
    "decoder",
    "codec",
    "validate",
    "parse"
  ],
  "author": "Joan Llenas Masó <joan.llenas.maso@gmail.com>",
  "contributors": [
    {
      "name": "Daniel van den Eijkel"
    }
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joanllenas/ts.data.json.git"
  },
  "bugs": {
    "url": "https://github.com/joanllenas/ts.data.json/issues"
  },
  "homepage": "https://github.com/joanllenas/ts.data.json#readme",
  "devDependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "~4.1.8",
    "eslint": "~10.4.1",
    "prettier": "~3.8.4",
    "typedoc": "~0.28.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.60.1",
    "vite": "~8.0.16",
    "vite-plugin-dts": "~5.0.2",
    "vitest": "~4.1.8"
  }
}
